{
    "name": "keybard",
    "version": "1.0.0",
    "description": "KeyBard is a companion software to the Svalboard (https://svalboard.com)",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "dev:local": "vite --host --port 5174",
        "build": "tsc && vite build",
        "check:side-panel": "node scripts/check-side-panel-overflow.cjs",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "test:e2e": "python tests/e2e/combo_editor_e2e.py",
        "test:e2e:fold": "python tests/e2e/combo_fold_e2e.py",
        "test:e2e:settings": "python tests/e2e/settings_e2e.py",
        "test:e2e:scroll-keys": "python tests/e2e/scroll_keys_e2e.py",
        "test:e2e:tap-dance": "python tests/e2e/tapdance_term_e2e.py",
        "test:e2e:pointing": "python tests/e2e/pointing_e2e.py",
        "test:e2e:firmware": "python tests/e2e/firmware_manual_e2e.py",
        "test:e2e:fake-board": "python tests/e2e/fake_board_e2e.py",
        "test:e2e:tester-pause": "python tests/e2e/tester_pause_e2e.py",
        "test:e2e:backups": "python tests/e2e/backups_panel_e2e.py",
        "test:e2e:scanlab-debounce": "python tests/e2e/scanlab_debounce_e2e.py",
        "test:e2e:scan-timing": "python tests/e2e/scan_timing_e2e.py",
        "test:e2e:select-contrast": "python tests/e2e/select_contrast_e2e.py",
        "test:e2e:international": "python tests/e2e/international_keys_e2e.py",
        "test:e2e:import-settings": "python tests/e2e/import_settings_e2e.py",
        "test:e2e:leader-timeout": "python tests/e2e/leader_timeout_e2e.py",
        "test:e2e:touchpad-taps": "python tests/e2e/touchpad_taps_e2e.py",
        "build:sval-preview": "tsc && vite build --mode sval-preview",
        "build:svalboard": "tsc && vite build --mode svalboard",
        "build:next": "tsc && vite build --mode next",
        "build:paranoid": "tsc && vite build --mode paranoid",
        "dev:sval-preview": "vite --mode sval-preview --host 127.0.0.1 --port 5176"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/chad3814/keybard.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/chad3814/keybard/issues"
    },
    "homepage": "https://github.com/chad3814/keybard#readme",
    "devDependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@testing-library/jest-dom": "^6.9.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/color": "^4.2.0",
        "@types/node": "^24.6.2",
        "@types/react": "^19.1.15",
        "@types/react-dom": "^19.1.9",
        "@types/w3c-web-hid": "^1.0.6",
        "@vitejs/plugin-react": "^5.0.4",
        "@vitest/coverage-v8": "^3.2.4",
        "jsdom": "^27.0.0",
        "parse5": "^7.3.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.2",
        "vite": "^7.1.7",
        "vite-plugin-singlefile": "^2.3.3",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@radix-ui/react-context-menu": "^2.2.16",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tailwindcss/vite": "^4.1.14",
        "@uidotdev/usehooks": "^2.4.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "color": "^5.0.2",
        "js-lzma": "^0.1.0",
        "lucide-react": "^0.544.0",
        "radix-ui": "^1.4.3",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-simple-keyboard": "^3.8.126",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^4.1.14",
        "xz-decompress": "^0.2.3"
    }
}
